# Resolved from 1Password at run time by `op run` (make up / scripts/up.sh).
# op:// entries are REFERENCES, not secrets; committed on purpose. Shared
# non-secrets (DOMAIN, TZ...) come from ../homelab.env.

# Admin API token for the jenkins-agents sidecar (the CI Agents card). Same
# token homepage/ and infra/ci-agent use; must belong to JENKINS_API_USER.
JENKINS_API_TOKEN=op://projects/homelab/jenkins_api_token

# --- non-secrets ---
JENKINS_API_USER=admin
