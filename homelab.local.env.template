# Per-host overrides of homelab.env. Copy to homelab.local.env (gitignored) on a
# host that differs from the committed defaults; unset keys fall through.
# The values below are the Mac dev host's. Literal values only: compose does
# not expand ${DOMAIN} inside env files.
DOMAIN=homelab.local
WG_HOST=home.vpn.dyerwolf.xyz
# ddns record this host owns in the zone, if any (see homelab.env).
RECORD_NAMES=home.vpn
MEDIA_HOST=/Volumes/homex/media1
MUSIC_HOST=/Volumes/homex/daniel/Music/Music/Media.localized

# Distinct Docker subnet and tailnet node name so this host's subnet router
# coexists with the server's instead of competing for 172.23.0.0/16. Changing
# NET_PREFIX on a running host means recreating traefik-public: scripts/down.sh,
# `docker network rm traefik-public`, then scripts/up.sh.
NET_PREFIX=172.24
TS_HOSTNAME=homelab-mac

# Use docker-compose.no-acme.yml overlays (self-signed TLS) instead of
# Let's Encrypt. Read by scripts/up.sh and common-docker.mk, not compose.
NO_ACME=true

# Emby API key for the homepage tile (media-streaming/docker-compose.yml).
# Unique to each Emby install, so it lives here rather than in 1Password:
# Emby > Settings > Advanced > API Keys > New. Leave empty until Emby is up.
EMBY_API_KEY=
