# Secret inputs, resolved from 1Password at run time by `op run` (see
# homepage/1pass.env). REFERENCES only; committed on purpose. Shared non-secrets
# (TZ, PUID, DOMAIN, MEDIA_*) come from ../homelab.env.

PROTONVPN_WIREGUARD_PRIVATE_KEY=op://projects/homelab/protonvpn_wireguard_private_key
PROTONVPN_SERVER_COUNTRIES=Spain

VPN_PORT_FORWARDING=on
VPN_PORT_FORWARDING_PROVIDER=protonvpn
FIREWALL_VPN_INPUT_PORTS=6881
