# Resolved from 1Password at run time by `op run` (make up / scripts/up.sh).
# op:// entries are REFERENCES, not secrets; committed on purpose. Shared
# non-secrets (DOMAIN, TZ, PUID...) come from ../homelab.env.

# Encrypts credentials stored in n8n's database. Losing it makes every saved
# credential unreadable, hence 1Password. Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=op://projects/homelab/n8n_encryption_key

# Lets the arr-download-watch workflow post messages through the OpenClaw
# gateway (http://openclaw:18789/tools/invoke). Same value as
# openclaw/1pass.env.
OPENCLAW_GATEWAY_TOKEN=op://projects/homelab/openclaw_gateway_token

# Hours a tracked download may run with no Sonarr/Radarr event before the
# watchdog reports it as possibly stalled.
ARR_WATCH_STALE_HOURS=6

# WhatsApp chat for the daily digest of imports nobody asked for (RSS grabs,
# monitored sequels, upgrades). The tv group; see openclaw/openclaw.json5.
DIGEST_CHAT=120363430627976443@g.us
