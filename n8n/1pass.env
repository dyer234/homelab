# Resolved from 1Password at run time by `op run` (make up / scripts/up.sh).
# op:// entries are REFERENCES, not secrets; committed on purpose. Shared
# non-secrets (DOMAIN, TZ, PUID...) come from ../homelab.env.

# Encrypts credentials stored in n8n's database. Losing it makes every saved
# credential unreadable, hence 1Password. Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=op://projects/homelab/n8n_encryption_key
