# Secret inputs, resolved from 1Password at run time by `op run`.
#
#   op run --env-file=1pass.env -- docker compose up -d      (or: make up)
#
# This file contains REFERENCES, not secrets, and is committed on purpose.
# Same pattern as tailscale/1pass.env: compose reads these names straight out
# of the process environment that `op run` populates.
#
# Homepage only substitutes env vars prefixed HOMEPAGE_VAR_ into its config
# files ({{HOMEPAGE_VAR_X}}), so docker-compose.yml re-exports the names below
# under that prefix rather than leaking every variable into the container.

# Jenkins API token for the CI agent tile in config/services.yaml. Minted in
# Jenkins under <your user> > Security > API Token. It is used as the basic-auth
# password alongside JENKINS_API_USER, so it MUST belong to that user.
JENKINS_API_TOKEN=op://projects/homelab/jenkins_api_token

# --- non-secrets ---
DOMAIN=homelab.local

# The Jenkins account the token above was generated on.
JENKINS_API_USER=admin
