# Resolved from 1Password at run time by `op run` (make up / scripts/up.sh).
# op:// entries are REFERENCES, not secrets; committed on purpose. Shared
# non-secrets (DOMAIN, TZ, PUID...) come from ../homelab.env.

# DigitalOcean API token for the DNS-01 ACME challenge. Same token infra/dns
# and ddns use.
DO_AUTH_TOKEN=op://projects/homelab/do_token

# --- non-secrets ---
# Let's Encrypt registration email.
ACME_EMAIL=daniel@dyerwolf.com
