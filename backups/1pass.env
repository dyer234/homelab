# Resolved from 1Password at run time by `op run` (make up / scripts/up.sh).
# op:// entries are REFERENCES, not secrets; committed on purpose. Shared
# non-secrets (DOMAIN, TZ, PUID...) come from ../homelab.env.
# No secrets here: B2 credentials live in rclone.conf (see rclone.conf.template).

# --- non-secrets ---
# Backblaze B2 bucket name.
# PROD: dyerwolf-homelab-backups
# DEV:  dyerwolf-homelab-backups-testing
B2_BUCKET=dyerwolf-homelab-backups-testing
# Cron schedule for backup.sh and how many days of backups to keep.
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=7
