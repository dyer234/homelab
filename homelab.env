# Variables shared by every docker compose app in this tree. Committed; no secrets.
#
# Loaded first by common-docker.mk and scripts/up.sh, so anything here can be
# overridden further up the chain (lowest to highest precedence):
#
#   homelab.env           this file: committed defaults (the Linux/prod host)
#   homelab.local.env     gitignored per-host overrides, e.g. DOMAIN=homelab.local
#                         on the Mac (see homelab.local.env.template)
#   <app>/.env            gitignored, app-specific values only
#   <app>/1pass.env       committed op:// references plus the app's non-secret
#                         config, resolved by `op run` into the process env,
#                         which beats every env file
#
# Because 1pass.env values win over homelab.local.env, anything that differs
# per host (paths, hostnames) must live HERE with the override in
# homelab.local.env, never in an app's 1pass.env.
#
# Note: once compose is given any --env-file it stops auto-loading <app>/.env,
# which is why both launchers pass it explicitly when it exists.

# Public domain. Services are exposed as <service>.${DOMAIN} via Traefik and
# infra/dns; DNS records for a new value are created there, not here.
DOMAIN=dyerwolf.xyz

TZ=America/Los_Angeles

# uid:gid the ARR stack, File Browser etc. run as, so files they write agree.
PUID=1000
PGID=1000

# Media library: host path and where the containers mount it. Every app that
# touches the library (media-streaming, filebrowser) uses the same pair so paths
# stored in Sonarr/Radarr/qBittorrent line up.
MEDIA_HOST=/mnt/media1/torrents
MEDIA_CONTAINER=/opt/media

# Music library for navidrome, same idea.
MUSIC_HOST=/opt/media/music
MUSIC_CONTAINER=/music

# WireGuard public endpoint. Read by wireguard (wg-easy) and by the homepage
# tile, so it is defined once here rather than in both.
WG_HOST=vpn.dyerwolf.xyz
