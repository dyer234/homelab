# Inputs for `op run --env-file=1pass.env -- tofu ...` (make plan / apply).
#
# This file contains 1Password REFERENCES, not secrets, and is committed on
# purpose. OpenTofu maps TF_VAR_<name> onto variable "<name>"; the three
# TF_VAR_jenkins_* below are read by scripts/jenkins_node.py directly instead
# (see there for why they are not tofu variables).
#
# THE FLEET IS CONFIGURED HERE. Edit and `make apply`:
#   TF_VAR_agent_count    how many droplets/agents. Shrinking removes the
#                         highest numbers, droplet and Jenkins node together.
#   TF_VAR_agent_name_prefix
#                         names are <prefix>-1 .. -N (Jenkins node name and
#                         tailnet hostname). Changing it REPLACES every agent.
#   TF_VAR_agent_labels   space-separated Jenkins labels on every agent. Changing
#                         them updates the nodes in place; droplets are untouched.
#
# Jenkins node objects and their JNLP secrets are created by tofu and never
# stored anywhere but terraform.tfstate.

TF_VAR_do_token=op://projects/homelab/do_token
TF_VAR_tailscale_auth_key=op://projects/homelab/tailscale_auth_key_ci_agent

# Jenkins admin API, used by tofu (from this machine) to create/delete nodes.
# Same token the Homepage dashboard uses; it must belong to TF_VAR_jenkins_api_user.
# Jenkins is addressed as https://jenkins.$DOMAIN, with DOMAIN from
# ../../homelab.env (exported by common-tofu.mk); set TF_VAR_jenkins_admin_url
# only to override that.
TF_VAR_jenkins_api_token=op://projects/homelab/jenkins_api_token
TF_VAR_jenkins_api_user=admin

# --- non-secrets ---
TF_VAR_agent_count=1
TF_VAR_agent_name_prefix=cloud-agent-amd64
TF_VAR_agent_labels=linux docker amd64
TF_VAR_agent_executors=1

# Without an SSH key a cloud-init failure is undebuggable: no tailnet means no
# Tailscale SSH, and the DO web console falls through to a password prompt.
# OpenTofu parses TF_VAR_ values for non-string types as HCL, so this is a list.
# Changing ssh_keys REPLACES the droplets.
TF_VAR_ssh_key_names=["adventuresum_ed25519"]
