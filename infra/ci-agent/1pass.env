# Secret inputs, resolved from 1Password at run time by `op run`.
#
#   op run --env-file=1pass.env -- tofu apply
#
# This file contains REFERENCES, not secrets, and is committed on purpose.
# Non-secret inputs (agent_name, ssh_key_names, region...) stay in
# terraform.tfvars, which is gitignored.
#
# OpenTofu maps TF_VAR_<name> onto variable "<name>", so the .tf files need no
# changes at all.
#
# If your vault or item is named differently, adjust the paths. Verify any one
# of them with:  op read "op://Homelab/homelab-infra/do_token"
TF_VAR_do_token=op://projects/homelab/do_token
TF_VAR_tailscale_auth_key=op://projects/homelab/tailscale_auth_key_ci_agent
TF_VAR_jenkins_agent_secret=op://projects/homelab/jenkins_agent_secret

# --- non-secrets ---
# MUST match the Jenkins node exactly (see jenkins/data/nodes/). A mismatch is
# rejected at the JNLP handshake, and the secret is per-node anyway.
TF_VAR_agent_name=cloud-linux-amd64-1

# Without an SSH key a cloud-init failure is undebuggable: no tailnet means no
# Tailscale SSH, and the DO web console falls through to a password prompt.
# OpenTofu parses TF_VAR_ values for non-string types as HCL, so this is a list.
# Changing ssh_keys REPLACES the droplet.
TF_VAR_ssh_key_names=["adventuresum_ed25519"]