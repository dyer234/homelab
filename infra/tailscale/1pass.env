# Inputs for `op run --env-file=1pass.env -- tofu ...` (make plan / apply).
#
# References, not secrets. See ../README.md, "Secrets".
#
# THE HOMELAB TAILNET, not the work one. These credentials belong to the
# separate Tailscale account that holds only the homelab and its build agents;
# the work tailnet (the Ohio exit node and its client) is under a different
# account and is not managed from this repo at all.
#
# ONE OAuth client is shared by this module, ../ci-agent and ../../tailscale.
# The provider still requests only the policy_file scope when it exchanges the
# secret for a token (see `scopes` in main.tf), so a token minted here cannot
# create keys or delete devices even though the client is allowed to.

TF_VAR_tailscale_oauth_client_id=op://projects/homelab/tailscale_client_id
TF_VAR_tailscale_oauth_client_secret=op://projects/homelab/tailscale_client_secret

# --- non-secrets ---
# One NET_PREFIX per stack; the controller address is <prefix>.<suffix> with
# the suffix from homelab.env (common-tofu.mk exports it). Tailnet-wide, so it
# is a list rather than this host's single NET_PREFIX. OpenTofu parses TF_VAR_
# values for non-string types as HCL. A stack that does not exist yet is
# harmless.
TF_VAR_jenkins_net_prefixes=["172.23","172.24"]
