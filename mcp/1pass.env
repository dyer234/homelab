# Resolved from 1Password at run time by `op run` (make up / scripts/up.sh).
# op:// entries are REFERENCES, not secrets; committed on purpose. Shared
# non-secrets (DOMAIN, TZ, PUID...) come from ../homelab.env.

# Signs every bearer token the gateway issues; rotating it logs every client
# out. Generate: openssl rand -hex 32
JWT_SECRET_KEY=op://projects/homelab/contextforge_jwt_secret

# Encrypts upstream credentials (API keys for Sonarr etc.) stored in the
# SQLite DB. Losing it makes them unreadable, hence 1Password.
# Generate: openssl rand -hex 32
AUTH_ENCRYPTION_SECRET=op://projects/homelab/contextforge_auth_encryption_secret

# Admin UI login at https://mcp.<DOMAIN>/admin. Only seeds the account on
# first start; later changes happen in the UI, not here.
PLATFORM_ADMIN_EMAIL=daniel@dyerwolf.com
PLATFORM_ADMIN_PASSWORD=op://projects/homelab/contextforge_admin_password

# mcp-jenkins in the stdio sidecar (docker-compose.yml). Same admin token
# infra/ci-agent and homepage use.
JENKINS_USERNAME=admin
JENKINS_API_TOKEN=op://projects/homelab/jenkins_api_token
