.env
media-streaming/config
home-traefik/letsencrypt
homepage/config/logs
homepage/config/custom.js
homepage/config/kubernetes.yaml
homepage/config/proxmox.yaml
backups/rclone.conf
n8n/data
mcp/data/*
!mcp/data/.gitkeep
openclaw/state/*
!openclaw/state/.gitkeep
openclaw/auth-secrets/*
!openclaw/auth-secrets/.gitkeep
# OpenClaw agent state. state/ and auth-secrets/ are its databases, WhatsApp
# session and credentials; memory/ is what the agent writes into its own
# workspace at run time (session corpus, dreams) and contains message
# content. The hand-written personas beside it (AGENTS.md, SOUL.md...) stay
# tracked.
openclaw/workspaces/*/memory/
ai/open-webui
ntavidrome/config
jenkins/data
navidrome/config
wireguard/config

# File Browser config/database (keep dir, ignore contents)
filebrowser/database/*
!filebrowser/database/.gitkeep

# Tailscale node state (keep dir, ignore contents)
tailscale/state/*
!tailscale/state/.gitkeep
tailscale/.env
.DS_Store
redis/data
jenkins/jobs
jenkins/stashed-users
homelab.local.env
home-traefik/scripts/__pycache__
infra/ci-agent/scripts/__pycache__
mcp/__pycache__
*__pycache__
openclaw/workspaces/media/DREAMS.md
