# Resolved from 1Password at run time by `op run` (make up / scripts/up.sh).
# op:// entries are REFERENCES, not secrets; committed on purpose. Shared
# non-secrets (DOMAIN, TZ, PUID...) come from ../homelab.env.

# Shared secret for the gateway: the Control UI login and every CLI call.
# Generate: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=op://projects/homelab/openclaw_gateway_token

# Model provider for both agents (agents.defaults.model in openclaw.json5).
# Same key Open WebUI uses. To log in with a ChatGPT/Codex subscription
# instead, run `make cli ARGS="onboard"` inside the container and drop this.
OPENAI_API_KEY=op://projects/homelab/openai_api_key
