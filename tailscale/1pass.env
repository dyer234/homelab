# Secret inputs, resolved from 1Password at run time by `op run`.
#
#   op run --env-file=1pass.env -- docker compose up -d
#
# This file contains REFERENCES, not secrets, and is committed on purpose.
# Same pattern as infra/*/1pass.env, but this stack is docker compose, not tofu:
# compose reads the variable names below straight out of the process
# environment (which `op run` populates), so they are the compose names, not
# TF_VAR_ ones.
#
# THE HOMELAB TAILNET, not the work one. This is the separate Tailscale account
# holding only the homelab and its build agents; the work tailnet (the Ohio exit
# node and its client) is under a different account and is not touched by this
# repo at all.
#
# The same OAuth client the two tofu modules use. Unlike them, containerboot
# does not request a narrower scope set -- it just presents the secret -- and
# the value sits in the container environment for as long as the container runs,
# where anything with the host Docker socket can read it (`docker inspect
# tailscale`). If that matters later, give this stack its own client scoped to
# auth_keys + tag:homelab and change only this line.
#
#   Admin console > Settings > OAuth clients
#     Scopes: policy_file WRITE, auth_keys WRITE, devices:core WRITE
#     Tags:   tag:homelab and tag:ci-agent on the tag-scoped ones
#
# The secret embeds its own client ID, so this is ONE value, not a pair.
#
# Store the BARE secret: docker-compose.yml appends
# ?preauthorized=true&ephemeral=false.
#
# tag:homelab must OWN ITSELF in tagOwners (infra/tailscale sets this) or the
# mint is rejected: an OAuth client is its own identity, not a user, so an
# admin-owned tag is not enough.
#
# With TS_AUTH_ONCE=true and a persistent ./state dir this is only exercised on
# first start and after state loss.
TS_OAUTH_SECRET=op://projects/homelab/tailscale_client_secret

# Non-secrets: TS_HOSTNAME and the advertised route (NET_PREFIX) are per-host,
# so they live in ../homelab.env / ../homelab.local.env, not here — values in
# this file reach compose through the process env and cannot be overridden.
