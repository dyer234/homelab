# Secret inputs, resolved from 1Password at run time by `op run`.
#
#   op run --env-file=1pass.env -- docker compose up -d
#
# This file contains REFERENCES, not secrets, and is committed on purpose.
# Same pattern as infra/*/1pass.env, but this stack is docker compose, not tofu:
# compose reads the variable names below straight out of the process
# environment (which `op run` populates), so they are the compose names, not
# TF_VAR_ ones.
#
# Generate a TAGGED, reusable, preauthorized key — the tag is what the
# autoApprovers block in infra/tailscale/policy.hujson grants route-approval to:
#
#   Admin console > Settings > Keys > Generate auth key
#     Reusable:      yes  (so a container recreate can re-register)
#     Ephemeral:     no   (this node is long-lived)
#     Pre-approved:  yes  (OAuth-issued keys default this to FALSE, which leaves
#                          the node unapproved and the route unadvertised)
#     Tags:          tag:homelab-docker
#
# The tag is ALSO asserted by TS_EXTRA_ARGS in docker-compose.yml, so an untagged
# key still produces a correctly tagged node. If you do put tags on the key, they
# must match that flag exactly or registration is rejected.
#
# With TS_AUTH_ONCE=true and a persistent ./state dir this is only consumed on
# first start, but keep it valid so a state-loss rebuild can re-register.
TS_AUTHKEY=op://projects/homelab/tailscale_auth_key_docker_subnet

# --- non-secrets ---
# Tailnet hostname / MagicDNS name for this node.
TS_HOSTNAME=homelab-docker

# Docker network to advertise. Must match the traefik-public subnet —
# check with: docker network inspect traefik-public --format '{{json .IPAM}}'
TS_ROUTES=172.23.0.0/16
