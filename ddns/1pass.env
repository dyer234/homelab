# Resolved from 1Password at run time by `op run` (make up / scripts/up.sh).
# op:// entries are REFERENCES, not secrets; committed on purpose. Shared
# non-secrets (DOMAIN, TZ, PUID...) come from ../homelab.env.

# DigitalOcean API token used to update the A records. Same token as infra/dns.
DO_TOKEN=op://projects/homelab/do_token

# --- non-secrets ---
# Comma-separated record names under DOMAIN to point at this host's public IP.
RECORD_NAMES=vpn
# Seconds between checks.
INTERVAL=300
