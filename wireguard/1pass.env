# Resolved from 1Password at run time by `op run` (make up / scripts/up.sh).
# op:// entries are REFERENCES, not secrets; committed on purpose. Shared
# non-secrets (DOMAIN, TZ, PUID...) come from ../homelab.env.

# bcrypt of the wg-easy admin password (the clear-text is wgeasy_password,
# which the homepage tile uses). Generate a new one with:
#   docker run --rm ghcr.io/wg-easy/wg-easy wgpw 'PASSWORD'
PASSWORD_HASH=op://projects/homelab/wgeasy_password_hash

# --- non-secrets ---
# WG_HOST (public endpoint) comes from ../homelab.env.
# DNS handed to connected clients.
WG_DEFAULT_DNS=1.1.1.1
# Route all client traffic through the tunnel; LAN access works via ip_forward.
WG_ALLOWED_IPS=0.0.0.0/0, ::/0
# Keepalive to hold NAT mappings open (seconds).
WG_PERSISTENT_KEEPALIVE=25
